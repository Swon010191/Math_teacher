# Cấu hình AI cho Recognition
# Mặc định dùng MockRecognitionProvider (không cần cấu hình gì).

# Loại provider: mock | ollama_vision | pix2text
RECOGNITION_PROVIDER=mock

# Ollama (khi dùng OllamaVisionProvider)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava

# Pix2Text (khi dùng Pix2TextProvider)
# Cài: pip install pix2text[serve] rồi chạy 'p2t serve'
PIX2TEXT_URL=http://localhost:8503

# Trạng thái khả dụng của từng provider xem tại popover "AI sẵn sàng"
# (nút "Kiểm tra lại" ping lại dịch vụ; ping chỉ chạy khi mở popover).

# CORS: các địa chỉ frontend được phép gọi API (thêm domain khi đóng gói/prod).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Teacher Copilot (đề xuất nội dung giảng dạy)
# Loại provider: rule_based | ollama
# Có thể đổi lúc chạy qua UI (panel "Gợi ý"); khởi động lại sẽ trở về giá trị này.
COPILOT_PROVIDER=rule_based
# Model chat dùng cho Copilot (khi COPILOT_PROVIDER=ollama)
OLLAMA_MODEL_COPILOT=llama3.2

# Knowledge references (all optional; only fixed MediaWiki hosts/pages are used)
KNOWLEDGE_EXTERNAL_ENABLED=true
KNOWLEDGE_HTTP_TIMEOUT_SECONDS=1.5
KNOWLEDGE_MAX_RESPONSE_BYTES=262144
KNOWLEDGE_CACHE_TTL_SECONDS=900
KNOWLEDGE_CACHE_STALE_SECONDS=86400
KNOWLEDGE_CACHE_MAX_ENTRIES=24
# Local Ollama translation is opt-in and receives source prose, never expressions.
KNOWLEDGE_OLLAMA_TRANSLATION_ENABLED=false
KNOWLEDGE_OLLAMA_TIMEOUT_SECONDS=3
